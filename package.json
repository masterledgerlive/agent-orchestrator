{
  "name": "agent-orchestrator",
  "version": "1.0.0",
  "description": "Autonomous LLM execution on blockchain. Retrieve genome, recall memories, access credentials, execute queries, update yourself.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "ethers": "^6.10.0",
    "@solana/web3.js": "^1.90.0",
    "axios": "^1.12.0",
    "dotenv": "^17.2.2",
    "zod": "^4.1.12",
    "nanoid": "^5.1.5",
    "pino": "^8.17.2",
    "redis": "^4.6.0",
    "node-cache": "^5.1.2",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3",
    "tsx": "^4.19.1",
    "esbuild": "^0.25.0",
    "vitest": "^2.1.4",
    "prettier": "^3.6.2",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
